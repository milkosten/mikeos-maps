<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- MikeAgent runtime (com.mikeos.core) resident heartbeat + live hive socket. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- MikeStreet dashboard capture — requested at runtime ONLY when the user opts in. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MikeMaps">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MikeMaps">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Be the phone's maps handler: any app's geo: link (incl. MikeShopping "Directions")
                 opens MikeMaps and routes to it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <!-- MikeAgent runtime Agent Inspector UI (com.mikeos.core, source-vendored).
             Not auto-merged from the core manifest, so declared here explicitly. -->
        <activity
            android:name="com.mikeos.core.ui.AgentInspectorActivity"
            android:exported="false" />

        <!-- MikeAgent runtime heartbeat: holds the live hive WebSocket open and ticks
             MikeAgent.beat(). specialUse FGS, per mikeos-android-core's manifest. -->
        <service
            android:name="com.mikeos.core.runtime.HeartbeatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Resident MikeAgent heartbeat and live hive connection" />
        </service>
    </application>
</manifest>
